# Souvenir marketing site — environment variables
# Copy to `.env.local` for local overrides (git-ignored). Set the real values
# in your hosting provider (e.g. Vercel project env) for production.

# Google Analytics 4 measurement ID (format: G-XXXXXXXXXX).
# Only loaded when NODE_ENV=production, so local/dev traffic is not tracked.
# If unset, the build falls back to the default property in src/app/layout.tsx.
NEXT_PUBLIC_GA_ID=G-ZLCFW0RLZJ
